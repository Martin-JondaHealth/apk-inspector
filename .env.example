# Service Port (default 3001)
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL via Prisma)
# Configurable local Docker Postgres host port (defaults to 5438 to avoid local port collisions)
POSTGRES_PORT=5438

# Local Docker Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5438/apk_inspector?schema=public"

# Production Neon.tech Postgres:
# DATABASE_URL="postgresql://<username>:<password>@<neon-hostname>/<dbname>?sslmode=require"
DATABASE_URL=

# LLM Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=8192
GEMINI_THINKING_BUDGET=0
OPENAI_API_KEY=
